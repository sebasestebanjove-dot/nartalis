# Nartalis — variables de entorno
# Copia a .env.local y rellena los valores.

# Base de datos Neon (PostgreSQL)
DATABASE_URL=postgresql://user:password@host/db

# Secret para el endpoint /api/revalidate (Bearer token)
REVALIDATION_SECRET=cambiar-por-secreto-fuerte

# URL pública del sitio (usada por el script de import para purgar caché)
SITE_URL=https://nartalis.com
NEXT_PUBLIC_SITE_URL=https://nartalis.com

# Analytics (opcional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=

# Los secrets se configuran en GitHub → Settings → Secrets → Actions:
#   DATABASE_URL, REVALIDATION_SECRET, SITE_URL
