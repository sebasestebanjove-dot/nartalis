# Nartalis — variables de entorno
# Copia a .env.local y rellena los valores.

# Base de datos Neon (PostgreSQL)
DATABASE_URL=postgresql://user:password@host/db

# Secret para el endpoint /api/revalidate (Bearer token)
REVALIDATION_SECRET=cambiar-por-secreto-fuerte

# URL pública del sitio (usada por el script de import para purgar caché)
SITE_URL=https://nartalis.com
NEXT_PUBLIC_SITE_URL=https://nartalis.com

# Analytics (opcional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=

# Auth — cuenta central Nartalis (FASE 2)
# NEXTAUTH_SECRET: firma de sesiones JWT (reutiliza la misma secret del módulo Dermo)
NEXTAUTH_SECRET=
# NEXTAUTH_URL: base URL pública (en local: http://localhost:3000)
NEXTAUTH_URL=http://localhost:3000
# Google Sign-In (OAuth 2.0) — Client ID y Secret de Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Apple (OPCIONAL — sin configurar muestra "próximamente" en el flujo)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Los secrets se configuran en GitHub → Settings → Secrets → Actions:
#   DATABASE_URL, REVALIDATION_SECRET, SITE_URL
